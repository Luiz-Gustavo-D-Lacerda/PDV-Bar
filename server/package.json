{
  "name": "pdv-bar-server",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "dev": "node node_modules/nodemon/bin/nodemon.js src/index.js",
    "start": "node src/index.js",
    "postinstall": "node -e \"const{cpSync,existsSync}=require('fs');const src='../node_modules/.prisma/client';const dst='node_modules/.prisma/client';if(existsSync(src))cpSync(src,dst,{recursive:true,force:true});\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  }
}
